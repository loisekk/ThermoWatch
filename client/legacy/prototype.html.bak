// js/data/firms.js — simulated NASA FIRMS MODIS/VIIRS active-fire feed (seeded)
import { mulberry32, gauss } from '../utils/geo.js';

const rng = mulberry32(26162);
const FRP_PROFILE = {
  refinery:[260,90], steel:[120,40], smelter:[200,60], cement:[90,25], power:[70,20],
  gas:[180,60], chemical:[150,70], waste:[45,15], flare:[620,140]
};
const WF_CLUSTERS = [
  [30.42,79.55],[21.60,80.40],[13.90,76.60],[31.90,77.30],
  [-5.60,-60.20],[39.20,-120.60],[2.10,103.40]
];
let seq = 0;

function mkEvent(lat, lon, frp, ts, extra = {}){
  const brightness = 300 + frp * 0.4 + gauss(rng) * 8;
  const confidence = Math.max(30, Math.min(100, Math.round(55 + frp / 12 + rng() * 25)));
  return {
    id: 'E' + String(++seq).padStart(5, '0'),
    lat: +lat.toFixed(4), lon: +lon.toFixed(4),
    frp: +frp.toFixed(1), brightness: +brightness.toFixed(1),
    confidence,
    daynight: rng() < 0.5 ? 'D' : 'N',
    satellite: rng() < 0.62 ? 'VIIRS-SNPP' : 'MODIS-AQUA',
    ts, ...extra
  };
}

export function buildHistoricalEvents(facs){
  const now = Date.now();
  const evts = [];

  for (const f of facs){
    const [mu, sd] = FRP_PROFILE[f.type];
    const days = f.persistent ? 10 + Math.floor(rng() * 5) : 1 + Math.floor(rng() * 3);
    for (let d = 0; d < days; d++){
      const n = 1 + Math.floor(rng() * 3);
      for (let k = 0; k < n; k++){
        const frp = Math.max(8, mu + gauss(rng) * sd * (f.persistent ? 0.35 : 1));
        const ts = now - d * 86400000 - Math.floor(rng() * 20) * 3600000;
        evts.push(mkEvent(f.lat + gauss(rng)*0.012, f.lon + gauss(rng)*0.012, frp, ts, { facilityId: f.id }));
      }
    }
  }
  for (const [cla, clon] of WF_CLUSTERS){
    const days = 1 + Math.floor(rng() * 3);
    const n = 8 + Math.floor(rng() * 10);
    for (let i = 0; i < n; i++){
      const d = Math.floor(rng() * days);
      evts.push(mkEvent(cla + gauss(rng)*0.30, clon + gauss(rng)*0.30, 25 + rng()*120,
        now - d*86400000 - Math.floor(rng()*22)*3600000, {}));
    }
  }
  for (let i = 0; i < 46; i++){ // Punjab/Haryana residue burning
    const d = Math.floor(rng() * 4);
    evts.push(mkEvent(30.9 + gauss(rng)*0.45, 75.8 + gauss(rng)*0.45, 18 + rng()*60,
      now - d*86400000 - Math.floor(rng()*10)*3600000, {}));
  }
  for (let i = 0; i < 14; i++){ // scattered unclassified
    evts.push(mkEvent(8 + rng()*28, 70 + rng()*26, 12 + rng()*40,
      now - Math.floor(rng()*6)*86400000 - Math.floor(rng()*23)*3600000, {}));
  }
  return evts.sort((a, b) => b.ts - a.ts);
}

export function spawnLiveEvent(events, facs){
  const r = rng();
  const persistentPool = events.filter(e => (e.consecutiveDays || 0) >= 3 && e.facilityId);
  if (r < 0.5 && persistentPool.length){
    const base = persistentPool[Math.floor(rng() * persistentPool.length)];
    const f = facs.find(x => x.id === base.facilityId);
    const [mu, sd] = FRP_PROFILE[f.type];
    return mkEvent(f.lat + gauss(rng)*0.012, f.lon + gauss(rng)*0.012,
      Math.max(8, mu + gauss(rng)*sd*0.3), Date.now(), { facilityId: f.id });
  }
  if (r < 0.75){
    const c = WF_CLUSTERS[Math.floor(rng() * 4)];
    return mkEvent(c[0] + gauss(rng)*0.3, c[1] + gauss(rng)*0.3, 25 + rng()*110, Date.now(), {});
  }
  if (r < 0.9){
    return mkEvent(30.9 + gauss(rng)*0.45, 75.8 + gauss(rng)*0.45, 18 + rng()*55, Date.now(), {});
  }
  const f = facs[Math.floor(rng() * facs.length)];
  return mkEvent(f.lat + gauss(rng)*0.05, f.lon + gauss(rng)*0.05, 30 + rng()*120, Date.now(), { facilityId: f.id });
}

