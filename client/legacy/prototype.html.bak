
                        <!DOCTYPE html>
                        <html lang="en">
                        <head>
                            <meta charset="UTF-8">
                            <meta name="viewport" content="width=device-width, initial-scale=1.0">
              <style>
                body {
                  background-color: white; /* Ensure the iframe has a white background */
                }

                :root{
  --bg-0:#050807; --bg-1:#0a0f0d; --bg-2:#0e1512; --bg-3:#141d18; --bg-4:#1b2721;
  --line:#1e2b24; --line-2:#2a3a31;
  --tx-0:#e6edf3; --tx-1:#a7b8ae; --tx-2:#6d7d73; --tx-3:#48564e;
  --grn:#3fb950; --grn-dim:#1f6f34;
  --red:#ff4444; --org:#ff8c42; --org2:#ff6b35; --yel:#ffb800;
  --blu:#1f6feb; --gry:#8b949e;
  --font-mono:'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
  --r:4px;
}

*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{
  background:var(--bg-0); color:var(--tx-0);
  font:12px/1.5 var(--font-mono); letter-spacing:.02em;
  overflow:hidden;
}
button{font:inherit;color:inherit;background:none;border:none;cursor:pointer}
input,select{font:inherit;color:var(--tx-0);background:var(--bg-2);border:1px solid var(--line-2);border-radius:var(--r);padding:4px 8px;outline:none}
input:focus,select:focus{border-color:var(--grn-dim)}
input::placeholder{color:var(--tx-3)}
.hidden{display:none!important}
::-webkit-scrollbar{width:8px;height:8px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--bg-4);border-radius:4px}
::-webkit-scrollbar-thumb:hover{background:var(--line-2)}
::selection{background:var(--grn-dim);color:#fff}
.badge{padding:2px 8px;border:1px solid var(--line-2);border-radius:var(--r);color:var(--tx-1);font-size:10px;letter-spacing:.08em;white-space:nowrap}
.dot{width:6px;height:6px;border-radius:50%;flex:none}

#app{display:grid;grid-template-rows:46px 34px 1fr 30px;height:100vh}
#workspace{display:grid;grid-template-columns:1fr 460px;min-height:0}
#map-section{display:flex;flex-direction:column;min-width:0;border-right:1px solid var(--line)}
#map-wrap{position:relative;flex:1;min-height:0;background:var(--bg-0)}
#map2d,#map3d{position:absolute;inset:0}
#map3d{overflow:hidden}
#right-rail{display:flex;flex-direction:column;min-height:0;background:var(--bg-1)}
#rail-bottom{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line);border-top:1px solid var(--line);flex:1;min-height:0}
.rail-card{background:var(--bg-1);min-height:0;display:flex;flex-direction:column}
#news-panel{flex:0 0 46%;border-bottom:1px solid var(--line)}
#statusbar{display:flex;align-items:center;gap:16px;padding:0 12px;background:var(--bg-1);border-top:1px solid var(--line);font-size:10px;color:var(--tx-2);white-space:nowrap;overflow:hidden}
#statusbar .sb-brand{color:var(--tx-0);font-weight:700;letter-spacing:.1em}
#statusbar .sb-links{display:flex;gap:14px;margin-left:auto}
#statusbar .sb-link{color:var(--tx-2);cursor:pointer}
#statusbar .sb-link:hover{color:var(--grn)}
@media (max-width:1100px){
  #workspace{grid-template-columns:1fr;grid-template-rows:minmax(0,1fr) 42vh}
  #map-section{border-right:none;border-bottom:1px solid var(--line)}
}

#topbar{display:flex;align-items:center;gap:14px;padding:0 12px;background:var(--bg-1);border-bottom:1px solid var(--line)}
.tb-left{display:flex;align-items:center;gap:8px}
.logo-flame{width:18px;height:18px;flex:none}
.logo-name{font-weight:700;letter-spacing:.14em}
.ver,.handle{color:var(--tx-2);font-size:10px}
.live-wrap{display:flex;align-items:center;gap:6px;margin-left:6px}
.live-dot{width:8px;height:8px;border-radius:50%;background:var(--grn);box-shadow:0 0 8px var(--grn);animation:pulse 2s infinite}
@keyframes pulse{50%{opacity:.35}}
.live-txt{font-size:10px;color:var(--grn);letter-spacing:.1em}
.tb-mid{display:flex;align-items:center;gap:10px;flex:1;min-width:0}
.badge.mission{border-color:var(--grn-dim);color:var(--grn)}
.badge.mission::before{content:'●';margin-right:5px;font-size:8px}
#threat-pct{color:var(--tx-2);font-size:10px}
.alert-pill{display:flex;align-items:center;gap:6px;padding:2px 10px;border:1px solid var(--org2);border-radius:14px;color:var(--org);font-size:10px;font-weight:700}
.tb-right{display:flex;align-items:center;gap:8px}
#search-input{width:190px}
.tb-btn{padding:4px 10px;border:1px solid var(--line-2);border-radius:var(--r);color:var(--tx-1);font-size:11px}
.tb-btn:hover{border-color:var(--grn-dim);color:var(--tx-0)}
.tb-btn.primary{background:var(--grn);border-color:var(--grn);color:#04140a;font-weight:700}
#tabrow{display:flex;align-items:flex-end;gap:4px;padding:4px 10px 0;background:var(--bg-0);border-bottom:1px solid var(--line)}
.tab{padding:6px 16px;border:1px solid var(--line);border-bottom:none;border-radius:6px 6px 0 0;color:var(--tx-2);font-size:11px}
.tab:hover{color:var(--tx-1)}
.tab.active{background:var(--bg-1);color:var(--grn);border-color:var(--line-2);font-weight:700}
.tab-add{color:var(--tx-3);padding:0 10px 6px}

#map-header{display:flex;align-items:center;gap:12px;height:34px;padding:0 12px;background:var(--bg-1);border-bottom:1px solid var(--line);font-size:11px;letter-spacing:.1em}
#situation-title{font-weight:700}
#clock{color:var(--tx-2);letter-spacing:.06em}
.mh-spacer{flex:1}
.mh-toggle{display:flex;border:1px solid var(--line-2);border-radius:var(--r);overflow:hidden}
.mh-btn{padding:3px 10px;color:var(--tx-2);font-size:10px}
.mh-btn:hover{color:var(--tx-0)}
.mh-btn.active{background:var(--grn);color:#04140a;font-weight:700}
#beta-badge{position:absolute;top:12px;right:52px;z-index:900;padding:2px 10px;border:1px solid var(--blu);color:var(--blu);border-radius:var(--r);font-size:10px;letter-spacing:.12em;background:rgba(10,15,13,.85)}
.float-panel{position:absolute;z-index:900;background:rgba(10,15,13,.93);border:1px solid var(--line-2);border-radius:6px;backdrop-filter:blur(6px)}
#timerange{top:12px;left:12px;display:flex;padding:4px;gap:2px}
.tr-btn{padding:6px 11px;font-size:10px;color:var(--tx-2);border-radius:4px}
.tr-btn:hover{color:var(--tx-0);background:var(--bg-3)}
.tr-btn.active{background:var(--grn);color:#04140a;font-weight:700}
#layer-panel{top:58px;left:12px;width:236px;max-height:calc(100% - 130px);display:flex;flex-direction:column}
.lp-head{display:flex;justify-content:space-between;align-items:center;padding:8px 10px;border-bottom:1px solid var(--line);font-size:10px;letter-spacing:.14em;color:var(--tx-1)}
.lp-caret{color:var(--tx-2);padding:0 4px}
.lp-search{padding:8px 10px;border-bottom:1px solid var(--line)}
.lp-search input{width:100%}
.lp-list{overflow-y:auto;padding:6px}
#layer-panel.collapsed .lp-list,#layer-panel.collapsed .lp-search,#layer-panel.collapsed .lp-foot{display:none}
.lp-row{display:flex;align-items:center;gap:8px;padding:6px;border-radius:4px}
.lp-row:hover{background:var(--bg-3)}
.lp-row input[type=checkbox]{accent-color:var(--grn);width:14px;height:14px;flex:none;cursor:pointer}
.lp-ico{width:16px;text-align:center;flex:none}
.lp-label{flex:1;font-size:10px;letter-spacing:.06em;color:var(--tx-1)}
.lp-info{width:18px;height:18px;flex:none;border:1px solid var(--line-2);border-radius:50%;color:var(--blu);font-size:10px;line-height:1}
.lp-info:hover{border-color:var(--blu)}
.lp-foot{padding:6px 10px;border-top:1px solid var(--line);color:var(--grn);font-size:10px}
#map-controls{position:absolute;top:12px;right:12px;z-index:900;display:flex;flex-direction:column;gap:4px}
.mc-btn{width:30px;height:30px;background:rgba(10,15,13,.93);border:1px solid var(--line-2);border-radius:4px;color:var(--tx-1);font-size:14px}
.mc-btn:hover{color:var(--grn);border-color:var(--grn-dim)}
#detail-drawer{position:absolute;top:0;right:0;bottom:0;width:344px;z-index:950;background:rgba(10,15,13,.97);border-left:1px solid var(--line-2);padding:14px;overflow-y:auto}
.dd-head{display:flex;justify-content:space-between;align-items:flex-start;gap:8px;margin-bottom:4px}
.dd-class{font-size:13px;font-weight:700;letter-spacing:.08em;display:flex;align-items:center;gap:8px}
.dd-close{color:var(--tx-2);font-size:14px;padding:2px 6px}
.dd-close:hover{color:var(--red)}
.dd-sub{color:var(--tx-2);font-size:10px;margin-bottom:10px}
.conf-bar{height:6px;background:var(--bg-3);border-radius:3px;overflow:hidden;margin:6px 0 12px}
.conf-fill{height:100%;border-radius:3px}
.dd-row{display:flex;justify-content:space-between;gap:10px;padding:5px 0;border-bottom:1px dashed var(--line);font-size:11px}
.dd-k{color:var(--tx-2)}
.dd-v{text-align:right}
.dd-fac{margin:12px 0;padding:9px;border:1px solid var(--line-2);border-radius:6px;background:var(--bg-2);font-size:11px}
.dd-fac .f-name{font-weight:700;color:var(--tx-0)}
.dd-fac .f-meta{color:var(--tx-2);font-size:10px;margin-top:3px}
.dd-h{font-size:10px;letter-spacing:.12em;color:var(--tx-2);margin:12px 0 6px}
.dd-actions-list{list-style:none;font-size:11px;color:var(--tx-1)}
.dd-actions-list li{padding:3px 0 3px 14px;position:relative}
.dd-actions-list li::before{content:'▸';position:absolute;left:0;color:var(--grn)}
.dd-actions{display:flex;gap:8px;margin-top:14px}
.leaflet-container{background:#050807!important;font-family:var(--font-mono)!important}
.leaflet-control-attribution{background:rgba(5,8,7,.75)!important;color:var(--tx-3)!important;font-size:9px!important}
.leaflet-control-attribution a{color:var(--tx-2)!important}
.fac-icon{background:transparent!important;border:none!important}
.fac-tip{background:var(--bg-2)!important;border:1px solid var(--line-2)!important;color:var(--tx-1)!important;font:10px var(--font-mono)!important;border-radius:4px!important;padding:3px 7px!important;box-shadow:none!important}
.fac-tip::before{display:none!important}
.fac-label{background:transparent!important;border:none!important;color:var(--tx-2)!important;font:9px var(--font-mono)!important;text-shadow:0 0 4px #000;white-space:nowrap}

.rail-head{display:flex;align-items:center;gap:8px;padding:9px 10px;border-bottom:1px solid var(--line);font-size:10px;letter-spacing:.14em;color:var(--tx-1);flex:none}
.rail-head .r-title{font-weight:700;color:var(--tx-0)}
.rail-head .dot{background:var(--red);box-shadow:0 0 6px var(--red)}
.rail-head .count{color:var(--red);font-weight:700}
.rail-head .spacer{flex:1}
.rh-btn{color:var(--tx-2);padding:0 4px}
.rh-btn:hover{color:var(--tx-0)}
.live-badge{padding:2px 9px;border:1px solid var(--grn-dim);color:var(--grn);border-radius:10px;font-size:9px;letter-spacing:.1em}
.live-badge::before{content:'●';margin-right:4px;font-size:7px}
#news-sources{display:flex;gap:4px;padding:8px 10px;overflow-x:auto;border-bottom:1px solid var(--line);flex:none;scrollbar-width:none}
#news-sources::-webkit-scrollbar{display:none}
.src-chip{flex:none;padding:3px 9px;font-size:9px;letter-spacing:.06em;border:1px solid var(--line-2);border-radius:3px;color:var(--tx-2);cursor:pointer}
.src-chip:hover{color:var(--tx-1)}
.src-chip.active{background:var(--red);border-color:var(--red);color:#fff;font-weight:700}
#news-list{flex:1;overflow-y:auto;padding:8px 10px;display:flex;flex-direction:column;gap:8px}
.news-item{border:1px solid var(--line);border-radius:6px;padding:8px;background:var(--bg-2)}
.news-item .ni-top{display:flex;justify-content:space-between;font-size:9px;color:var(--tx-2);margin-bottom:4px}
.ni-src{font-weight:700}
.news-item p{font-size:11px;color:var(--tx-1)}
.news-item p .cite{color:var(--blu)}
.news-play{margin:0 10px 10px;padding:10px;border:1px dashed var(--line-2);border-radius:6px;text-align:center;color:var(--tx-2);font-size:10px;flex:none}
.news-play button{margin-top:6px;padding:4px 14px;border:1px solid var(--red);color:var(--red);border-radius:4px;font-size:10px;letter-spacing:.1em}
.news-play button:hover{background:var(--red);color:#fff}
#insights-panel{overflow:hidden}
#insights-body{flex:1;overflow-y:auto;padding:8px}
.brief{padding:10px;background:var(--bg-2);border:1px solid var(--line);border-left:3px solid var(--blu);border-radius:4px;font-size:11px;color:var(--tx-1)}
.brief .b-head{display:flex;align-items:center;gap:6px;font-size:10px;letter-spacing:.12em;color:var(--tx-0);font-weight:700;margin-bottom:6px}
.brief b{color:var(--tx-0)}
.cite{color:var(--blu)}
.metric-row{display:grid;grid-template-columns:1fr 1fr 1.4fr;gap:1px;background:var(--line);border:1px solid var(--line);border-radius:6px;overflow:hidden;margin-top:8px}
.stat{background:var(--bg-1);padding:8px}
.stat .v{font-size:17px;font-weight:700}
.stat .k{font-size:9px;color:var(--tx-2);letter-spacing:.06em}
.stat .v.warn{color:var(--org)}
#timeline-panel{overflow:hidden}
#tl-stats{display:grid;grid-template-columns:1fr 1fr 1.4fr;gap:1px;background:var(--line);border-bottom:1px solid var(--line);flex:none}
#tl-canvas{width:100%;flex:1;min-height:110px;display:block}
.snap{border:1px solid var(--grn-dim);color:var(--grn);border-radius:10px;padding:2px 9px;font-size:9px;letter-spacing:.08em}
.snap::before{content:'●';margin-right:4px;font-size:7px}

#toast-stack{position:fixed;right:16px;bottom:44px;z-index:2000;display:flex;flex-direction:column;gap:8px;width:330px}
.toast{border:1px solid var(--line-2);border-left:4px solid var(--red);background:rgba(14,21,18,.97);border-radius:6px;padding:10px 12px;box-shadow:0 8px 24px rgba(0,0,0,.55);animation:slidein .25s ease}
@keyframes slidein{from{transform:translateX(24px);opacity:0}}
.toast .t-close{float:right;color:var(--tx-2);font-size:11px}
.toast .t-close:hover{color:var(--tx-0)}
.toast .t-title{font-size:11px;font-weight:700;letter-spacing:.08em}
.toast .t-msg{font-size:10px;color:var(--tx-1);margin-top:4px}
#analytics-overlay{position:fixed;inset:0;z-index:1500;background:rgba(5,8,7,.88);backdrop-filter:blur(4px);padding:56px 40px 40px;overflow-y:auto}
.ao-head{max-width:1200px;margin:0 auto 16px;display:flex;align-items:center;gap:12px}
.ao-head h2{font-size:14px;letter-spacing:.14em}
.ao-head .sub{color:var(--tx-2);font-size:10px}
.ao-close{margin-left:auto;padding:5px 14px;border:1px solid var(--line-2);border-radius:var(--r);color:var(--tx-1)}
.ao-close:hover{border-color:var(--red);color:var(--red)}
.ao-grid{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(330px,1fr));gap:14px}
.ao-card{background:var(--bg-1);border:1px solid var(--line-2);border-radius:8px;padding:14px}
.ao-card h3{font-size:11px;letter-spacing:.14em;color:var(--tx-1);margin-bottom:10px}
.ao-table{width:100%;border-collapse:collapse;font-size:10px}
.ao-table td,.ao-table th{padding:5px 6px;border-bottom:1px solid var(--line);text-align:left;color:var(--tx-1)}
.ao-table th{color:var(--tx-2);letter-spacing:.08em}
.ao-legend{display:flex;flex-direction:column;gap:5px;font-size:10px;color:var(--tx-1);margin-top:10px}
.ao-legend .lg{display:flex;align-items:center;gap:8px}
.ao-legend .sw{width:10px;height:10px;border-radius:2px;flex:none}
.ao-legend .val{margin-left:auto;color:var(--tx-0);font-weight:700}
.ao-bar-row{display:flex;align-items:center;gap:8px;font-size:10px;color:var(--tx-1);padding:4px 0}
.ao-bar{flex:1;height:8px;background:var(--bg-3);border-radius:4px;overflow:hidden}
.ao-bar > div{height:100%;background:var(--blu)}


              </style>
                        </head>
                        <body>
                            <!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>ThermoWatch — Industrial Fire & Thermal Anomaly Monitor</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Ctext y='13' font-size='13'%3E%F0%9F%94%A5%3C/text%3E%3C/svg%3E"/>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/fontsource/css/jetbrains-mono@latest/index.css"/>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/fontsource/css/jetbrains-mono@latest/700.css"/>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<link rel="stylesheet" href="css/variables.css"/>
<link rel="stylesheet" href="css/base.css"/>
<link rel="stylesheet" href="css/layout.css"/>
<link rel="stylesheet" href="css/components/topbar.css"/>
<link rel="stylesheet" href="css/components/map.css"/>
<link rel="stylesheet" href="css/components/sidebar.css"/>
<link rel="stylesheet" href="css/components/overlays.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script type="importmap">
{ "imports": { "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js" } }
</script>
</head>
<body>
<div id="app">
  <header id="topbar"></header>
  <nav id="tabrow"></nav>

  <main id="workspace">
    <section id="map-section">
      <div id="map-header">
        <span id="situation-title">INDIA SITUATION</span>
        <span id="clock">—</span>
        <span class="mh-spacer"></span>
        <div class="mh-toggle">
          <button id="btn-2d" class="mh-btn active">2D</button>
          <button id="btn-3d" class="mh-btn">3D</button>
        </div>
        <button id="btn-split" class="mh-btn icon" title="Split view (demo)">▥</button>
        <button id="btn-fs" class="mh-btn icon" title="Fullscreen">⛶</button>
      </div>

      <div id="map-wrap">
        <div id="map2d"></div>
        <div id="map3d" class="hidden"></div>
        <div id="timerange" class="float-panel"></div>
        <aside id="layer-panel" class="float-panel"></aside>
        <div id="map-controls">
          <button id="mc-zin"  class="mc-btn" title="Zoom in">+</button>
          <button id="mc-zout" class="mc-btn" title="Zoom out">−</button>
          <button id="mc-home" class="mc-btn" title="Reset view">⌂</button>
        </div>
        <span id="beta-badge" class="hidden">BETA</span>
        <div id="detail-drawer" class="hidden"></div>
      </div>
    </section>

    <aside id="right-rail">
      <section id="news-panel" class="rail-card"></section>
      <div id="rail-bottom">
        <section id="insights-panel" class="rail-card"></section>
        <section id="timeline-panel" class="rail-card"></section>
      </div>
    </aside>
  </main>

  <footer id="statusbar"></footer>
</div>

<div id="toast-stack"></div>
<div id="analytics-overlay" class="hidden"></div>

<script type="module" src="js/main.js"></script>
</body>
</html>


              <script>
                              // js/config.js — global constants & design tokens for the console
export const CONFIG = {
  appName: 'THERMOWATCH',
  version: 'v2.10.0',
  handle: '@sih26162',
  earthTexture: 'https://image.qwenlm.ai/public_source/98dfc6f4-5f5f-4337-bb11-7546436860b9/128e61377-7b39-4a35-92a3-57cbe6ebf7fb.png',
  // texture crop (avoids white margin / rounded corners of source asset)
  earthTextureCrop: { rx: 0.88, ry: 0.53, ox: 0.06, oy: 0.24 },

  colors: {
    industrial_fire:   '#ff4444',
    persistent_thermal:'#ff8c42',
    wildfire:          '#3fb950',
    agricultural:      '#ffb800',
    unknown:           '#8b949e'
  },
  classNames: {
    industrial_fire:   'INDUSTRIAL FIRE',
    persistent_thermal:'PERSISTENT THERMAL SOURCE',
    wildfire:          'WILDFIRE',
    agricultural:      'AGRICULTURAL BURN',
    unknown:           'UNCLASSIFIED'
  },
  classOrder: ['industrial_fire','persistent_thermal','wildfire','agricultural','unknown'],

  tiers: [ // descending thresholds — first match wins
    { min: 80, label: 'CRITICAL', color: '#ff4444' },
    { min: 60, label: 'HIGH',     color: '#ff6b35' },
    { min: 40, label: 'ELEVATED', color: '#ffb800' },
    { min: 20, label: 'GUARD',    color: '#3fb950' },
    { min: 0,  label: 'LOW',      color: '#8b949e' }
  ],

  ranges: {
    '1h': 3.6e6, '6h': 2.16e7, '24h': 8.64e7,
    '48h': 1.728e8, '7d': 6.048e8, 'ALL': Infinity
  },

  regions: {
    INDIA:      { bbox: [6, 68, 37, 98],     center: [22.5, 79],  zoom: 5 },
    SOUTH_ASIA: { bbox: [-12, 60, 40, 105],  center: [18, 82],    zoom: 4 },
    GLOBAL:     { bbox: [-60, -180, 85, 180],center: [24, 40],    zoom: 3 }
  },

  liveIntervalMs: 7000,
  persistMinDays: 5,
  facilityLinkKm: 6
};

// js/core/eventbus.js — minimal pub/sub bus
class Bus {
  constructor(){ this.m = new Map(); }
  on(topic, fn){ if(!this.m.has(topic)) this.m.set(topic, []); this.m.get(topic).push(fn); return () => this.off(topic, fn); }
  off(topic, fn){ const a = this.m.get(topic) || []; this.m.set(topic, a.filter(f => f !== fn)); }
  emit(topic, payload){ (this.m.get(topic) || []).slice().forEach(fn => fn(payload)); }
}
export const bus = new Bus();

// js/core/store.js — global state + selectors
import { CONFIG } from '../config.js';

export const state = {
  region: 'INDIA',
  range: '7d',
  mode: '2d',
  overlay: null,          // null | 'analytics'
  selected: null,         // event id
  layers: { hotspots:true, facilities:true, persistent:true, agri:true, wildfire:true, risk:false, labels:false },
  events: [],
  facilities: [],
  alerts: 0,
  threat: { level: 5, label: 'THREATCON 5', color: '#3fb950', pct: 8 }
};

const listeners = new Set();
export function setState(patch){ Object.assign(state, patch); listeners.forEach(fn => fn(state)); }
export function subscribe(fn){ listeners.add(fn); return () => listeners.delete(fn); }

export function visibleEvents(st = state){
  const box = CONFIG.regions[st.region].bbox;
  const span = CONFIG.ranges[st.range];
  const now = Date.now();
  return st.events.filter(e =>
    e.lat >= box[0] && e.lat <= box[2] &&
    e.lon >= box[1] && e.lon <= box[3] &&
    (span === Infinity || now - e.ts <= span)
  );
}

// js/utils/dom.js
export const $  = (s, r = document) => r.querySelector(s);
export const $$ = (s, r = document) => [...r.querySelectorAll(s)];
export function el(tag, cls, html){
  const n = document.createElement(tag);
  if (cls) n.className = cls;
  if (html != null) n.innerHTML = html;
  return n;
}

// js/utils/format.js
export const MON = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
export const WD  = ['SUN','MON','TUE','WED','THU','FRI','SAT'];
const p2 = n => String(n).padStart(2, '0');

export function fmtUTC(d = new Date()){
  return `${WD[d.getUTCDay()]}, ${p2(d.getUTCDate())} ${MON[d.getUTCMonth()]} ${d.getUTCFullYear()} ` +
         `${p2(d.getUTCHours())}:${p2(d.getUTCMinutes())}:${p2(d.getUTCSeconds())} UTC`;
}
export function fmtHM(ts){ const d = new Date(ts); return `${p2(d.getUTCHours())}:${p2(d.getUTCMinutes())} UTC`; }
export function fmtDay(ts){ const d = new Date(ts); return `${p2(d.getUTCDate())}/${p2(d.getUTCMonth()+1)}`; }
export function timeAgo(ts){
  const s = Math.max(1, (Date.now() - ts) / 1000);
  if (s < 60) return `${s|0}s ago`;
  if (s < 3600) return `${s/60|0}m ago`;
  if (s < 86400) return `${s/3600|0}h ago`;
  return `${s/86400|0}d ago`;
}
export const fmtInt = n => n.toLocaleString('en-US');

// js/utils/geo.js — seeded rng + geo helpers
export function mulberry32(a){
  return function(){
    a |= 0; a = a + 0x6D2B79F5 | 0;
    let t = Math.imul(a ^ a >>> 15, 1 | a);
    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
    return ((t ^ t >>> 14) >>> 0) / 4294967296;
  };
}
export const gauss = rng => (rng() + rng() + rng() - 1.5) / 1.5;

export function haversineKm(aLat, aLon, bLat, bLon){
  const R = 6371, dr = Math.PI / 180;
  const dLa = (bLat - aLat) * dr, dLo = (bLon - aLon) * dr;
  const s = Math.sin(dLa/2)**2 + Math.cos(aLat*dr) * Math.cos(bLat*dr) * Math.sin(dLo/2)**2;
  return 2 * R * Math.asin(Math.sqrt(s));
}
// ~5 km aggregation cell (stands in for H3 res-7 in the demo pipeline)
export const cellKey = (lat, lon) => `${lat.toFixed(2)}|${lon.toFixed(2)}`;

export function nearestFacility(facs, lat, lon){
  let best = null, bd = Infinity;
  for (const f of facs){
    const d = haversineKm(lat, lon, f.lat, f.lon);
    if (d < bd){ bd = d; best = f; }
  }
  return { fac: best, d: bd };
}
// Indo-Gangetic stubble-burn belt (Punjab / Haryana / W. UP)
export const inAgBelt = (lat, lon) => lat > 28.8 && lat < 32.6 && lon > 72.5 && lon < 78.8;

