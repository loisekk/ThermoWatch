# ThermoWatch API — environment template.
#
# Copy to `server/api/.env` (gitignored) and fill in real values.
# Every key is present here; every value is a safe placeholder.
# NONE of these may ever be hardcoded in source.

# --- Durable storage (Phase 0: PostgreSQL 17 + PostGIS 3.5) -------------------
# docker-compose `db` service matches this default, so compose needs no override.
TW_DATABASE_URL=postgresql+asyncpg://thermowatch:CHANGE_ME@localhost:5432/thermowatch
# 1 = fail startup when PostGIS is unreachable; 0 = boot degraded (v1 in-memory stays up).
TW_DB_REQUIRED=0

# --- CORS / browser origins --------------------------------------------------
# Comma-separated exact list. The regex allow-list (TW_ORIGIN_REGEX) covers the
# Vercel prod + preview/deployment URLs, so this list is the local/dev case.
TW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Write authorization (shared deployment) ---------------------------------
# Unset (default) = local/single-user mode: write endpoints are open.
# Set to a long random value to require `Authorization: Bearer <token>` on
# POST /v2/observations and POST /v2/incidents/{id}/reviews.
TW_WRITE_TOKEN=

# --- Interactive API docs ----------------------------------------------------
# 1 = expose /docs, /redoc, /openapi.json. Set 0 on any shared/hosted deploy.
TW_DOCS_ENABLED=1

# --- Providers (optional; every one degrades honestly when unset) ------------
# NASA FIRMS area API key (ingest worker also reads it; sim feed when empty).
FIRMS_API_KEY=
# Copernicus Data Space OAuth2 client_credentials (Sentinel-2 optical evidence).
TW_CDSE_CLIENT_ID=
TW_CDSE_CLIENT_SECRET=

# --- Phase 7 toggles ---------------------------------------------------------
# 0 = skip every outbound optical/weather call (offline-safe bulkhead).
TW_EXTERNAL_EVIDENCE_ENABLED=1
TW_LOADTEST_DB_ROWS=100000
