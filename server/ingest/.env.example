# Optional: live NASA FIRMS ingestion (https://firms.modaps.eosdis.nasa.gov/).
# Leave empty to run the built-in deterministic simulation feed (same contract).
FIRMS_API_KEY=

# FastAPI target for publishing detections
TW_API_URL=http://localhost:8000

# Poll cadence (ms). FIRMS rate limit is 5,000 req / 10 min per key — stay polite.
POLL_MS=20000

# Shared secret for POST /api/v1/ingest/events (set the same value on the API as
# TW_INGEST_TOKEN; leave empty for local dev where the endpoint is open).
TW_INGEST_TOKEN=
